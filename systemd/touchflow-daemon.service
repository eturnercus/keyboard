[Unit]
Description=TouchFlow On-Screen Keyboard
Documentation=https://github.com/touchflow/touchflow-keyboard
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/touchflowd
Restart=on-failure
RestartSec=3
Environment=GTK_USE_PORTAL=0
Environment=GTK_MODULES=gail:atk-bridge
Environment=QT_ACCESSIBILITY=1

[Install]
WantedBy=graphical-session.target
